<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- VECTOR_SEARCH() and vector indexes are experimental in both SQL Server 2025 and EF Core 11,
         so HasVectorIndex, VectorSearch, WithApproximate and VectorSearchResult<T> raise compile
         error EF9105 until you opt in. The API or the SQL it generates may still change. -->
    <NoWarn>$(NoWarn);EF9105</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The vector index is created by a migration, generated with the dotnet-ef CLI. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
