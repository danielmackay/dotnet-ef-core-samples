<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The AppHost runs with `dotnet run`, so the orchestrator and dashboard come from
         NuGet packages and the Aspire CLI bundle isn't needed. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>daabdc2a-304a-4fa8-91e0-f2a1745c5d8d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer"/>
  </ItemGroup>

</Project>
